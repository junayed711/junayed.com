---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      noindex={noindex}
    />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <div
      id="mobile-menu-backdrop"
      transition:persist
      aria-hidden="true"
      class="invisible fixed inset-0 z-40 bg-neutral-100/85 opacity-0 backdrop-blur-md transition-opacity duration-200 ease-out dark:bg-neutral-900/85 sm:hidden"
    ></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Pagefind />
    <script>
      import mediumZoom from "medium-zoom";

      function initZoom() {
        mediumZoom("article img", {
          background: "rgba(0, 0, 0, 0.85)",
          margin: 24,
        });
      }

      initZoom();
      document.addEventListener("astro:after-swap", initZoom);
    </script>
  </body>
</html>
