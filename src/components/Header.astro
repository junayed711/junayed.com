---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import CoffeeIcon from "@assets/coffee.svg";
import SearchIcon from "@assets/search.svg";
import MenuIcon from "@assets/menu.svg";
import CloseIcon from "@assets/close.svg";

const navItems = [
  { href: "/blog/", label: "blog" },
  { href: "/projects/", label: "projects" },
  { href: "/connect/", label: "let's connect" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between gap-4">
      <Link href="/" underline={false}>
        <div class="flex items-center gap-1.5 font-semibold">
          {SITE.TITLE}
          <CoffeeIcon width={16} height={16} />
        </div>
      </Link>

      <nav class="hidden items-center gap-4 text-sm sm:flex">
        {
          navItems.map((item) => (
            <Link
              href={item.href}
              active={isActive(item.href)}
              data-nav-link
            >
              {item.label}
            </Link>
          ))
        }
        <button
          data-search-trigger
          aria-label="Search"
          class="flex items-center rounded-sm border border-black/15 bg-neutral-100 px-2 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:bg-neutral-900 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        >
          <SearchIcon width={16} height={16} />
          &nbsp;Search
        </button>
      </nav>

      <div class="flex items-center gap-2 sm:hidden">
        <button data-search-trigger aria-label="Search" class="btn-icon">
          <SearchIcon width={16} height={16} />
        </button>
        <button
          id="hamburger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="btn-icon"
        >
          <MenuIcon width={18} height={18} data-menu-icon="open" />
          <CloseIcon
            width={18}
            height={18}
            data-menu-icon="close"
            class="hidden"
          />
        </button>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="mt-4 hidden flex-col gap-3 text-base sm:hidden"
    >
      {
        navItems.map((item) => (
          <Link href={item.href} active={isActive(item.href)} data-nav-link>
            {item.label}
          </Link>
        ))
      }
    </nav>
  </Container>
</header>

<script is:inline>
  function getMenuElements() {
    return {
      hamburger: document.getElementById("hamburger"),
      mobileMenu: document.getElementById("mobile-menu"),
      backdrop: document.getElementById("mobile-menu-backdrop"),
    };
  }

  function setMenuIcon(hamburger, open) {
    const openIcon = hamburger.querySelector('[data-menu-icon="open"]');
    const closeIcon = hamburger.querySelector('[data-menu-icon="close"]');
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  function closeMenu() {
    const { hamburger, mobileMenu, backdrop } = getMenuElements();
    if (!hamburger || !mobileMenu) return;
    hamburger.setAttribute("aria-expanded", "false");
    hamburger.setAttribute("aria-label", "Open menu");
    setMenuIcon(hamburger, false);
    mobileMenu.classList.add("hidden");
    mobileMenu.classList.remove("flex");
    backdrop?.classList.add("invisible", "opacity-0");
    backdrop?.classList.remove("visible", "opacity-100");
    document.body.style.overflow = "";
  }

  function openMenu() {
    const { hamburger, mobileMenu, backdrop } = getMenuElements();
    if (!hamburger || !mobileMenu) return;
    hamburger.setAttribute("aria-expanded", "true");
    hamburger.setAttribute("aria-label", "Close menu");
    setMenuIcon(hamburger, true);
    mobileMenu.classList.remove("hidden");
    mobileMenu.classList.add("flex");
    backdrop?.classList.remove("invisible", "opacity-0");
    backdrop?.classList.add("visible", "opacity-100");
    document.body.style.overflow = "hidden";
  }

  function toggleMenu() {
    const { hamburger } = getMenuElements();
    if (!hamburger) return;
    hamburger.getAttribute("aria-expanded") === "true"
      ? closeMenu()
      : openMenu();
  }

  function wireMenuElements() {
    const { hamburger, mobileMenu, backdrop } = getMenuElements();
    if (!hamburger || !mobileMenu || hamburger.dataset.wired === "true") return;
    hamburger.dataset.wired = "true";

    hamburger.addEventListener("click", toggleMenu);
    backdrop?.addEventListener("click", closeMenu);
    mobileMenu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeMenu));
  }

  function updateActiveNav() {
    const path = window.location.pathname;
    const activeClasses = [
      "text-black",
      "decoration-black/50",
      "dark:text-white",
      "dark:decoration-white/50",
    ];
    document.querySelectorAll("header [data-nav-link]").forEach((link) => {
      const href = link.getAttribute("href");
      const active = href ? path.startsWith(href) : false;
      activeClasses.forEach((cls) => link.classList.toggle(cls, active));
      if (active) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Guard against double-registering document listeners if the script re-runs.
  if (!window.__siteHeaderInit) {
    window.__siteHeaderInit = true;

    window
      .matchMedia("(min-width: 640px)")
      .addEventListener("change", (event) => {
        if (event.matches) closeMenu();
      });

    document.addEventListener("astro:before-swap", closeMenu);
    document.addEventListener("astro:after-swap", () => {
      wireMenuElements();
      updateActiveNav();
    });
  }

  wireMenuElements();
  updateActiveNav();
</script>
