---
import ArrowCard from "@components/ArrowCard.astro";
import { BOOKING, SITE, SOCIALS } from "@consts";

const rows = [
  {
    NAME: "Email",
    HANDLE: SITE.EMAIL,
    HREF: `mailto:${SITE.EMAIL}`,
    external: false,
  },
  ...[BOOKING, ...SOCIALS].map((contact) => ({ ...contact, external: true })),
];
---

<ul class="animate not-prose flex flex-col gap-4">
  {
    rows.map((row) => (
      <li class="relative">
        <ArrowCard href={row.HREF} external={row.external} arrow={row.external}>
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-semibold">{row.NAME}</span>
            <span class="truncate text-sm">{row.HANDLE}</span>
          </div>
        </ArrowCard>
        {!row.external && (
          <>
            <button
              type="button"
              data-copy={row.HANDLE}
              aria-label="Copy email address"
              title="Copy email address"
              class="group/copy absolute top-1/2 right-0 grid size-9 -translate-y-1/2 place-content-center transition-colors duration-300 ease-in-out hover:text-black focus-visible:text-black dark:hover:text-white dark:focus-visible:text-white"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="size-5 fill-none stroke-current stroke-2 group-data-copied/copy:hidden"
              >
                <rect x="9" y="9" width="12" height="12" rx="2" />
                <path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="hidden size-5 fill-none stroke-current stroke-2 group-data-copied/copy:block"
              >
                <polyline points="5 12 10 17 19 7" />
              </svg>
            </button>
            <span data-copy-status role="status" class="sr-only" />
          </>
        )}
      </li>
    ))
  }
</ul>

<script>
  const timers = new WeakMap<HTMLElement, number>();

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      "[data-copy]",
    );
    if (!button || !navigator.clipboard) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
    } catch {
      return;
    }

    const status = button.parentElement?.querySelector("[data-copy-status]");
    button.dataset.copied = "";
    if (status) status.textContent = "Email address copied";

    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.copied;
        if (status) status.textContent = "";
      }, 2000),
    );
  });
</script>
